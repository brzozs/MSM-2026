{
  "name": "vectorcast-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:data": "cd .. && python3 -u -m pipeline.measured_migration && python3 -m pipeline.publish",
